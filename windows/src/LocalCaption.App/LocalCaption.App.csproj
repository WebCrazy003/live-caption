<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LocalCaption.Audio\LocalCaption.Audio.csproj" />
    <ProjectReference Include="..\LocalCaption.Core\LocalCaption.Core.csproj" />
    <ProjectReference Include="..\LocalCaption.Session\LocalCaption.Session.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- §7.2 [DECISION]: virtualised rendering, so an hour-long transcript stays fluid, and
         Replace(offset, length, text) gives the same append-only update the macOS NSTextView
         gets. A FlowDocument with thousands of Paragraphs degrades badly, and rebuilding one
         per update drops the selection. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- §11's installer. The package is needed in the app itself, not just at pack time:
         VelopackApp.Build().Run() is what handles the install, update and uninstall hooks
         the installer invokes on this executable. -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Local Caption</ApplicationTitle>
    <AssemblyName>LocalCaption</AssemblyName>
    <Version>1.2.2</Version>
    <Product>Local Caption</Product>
    <Company>Richard &amp; Stevitech</Company>
    <Description>Live captions for whatever this PC is playing</Description>
    <!-- Drawn by build/make-icon.ps1. The .ico is the executable's and the taskbar's; the
         .png is the same mark for the title bar, which WPF scales better from one large
         frame than from an icon's fixed sizes. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The "send to chat" browser extension travels beside the executable, so Settings ▸ Send
         can open its folder on any install — published, portable or Velopack. -->
    <Content Include="../../extension/**/*" Link="extension/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app.png" />
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

</Project>
