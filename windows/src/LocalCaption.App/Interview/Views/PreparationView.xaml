<UserControl x:Class="LocalCaption.App.Interview.Views.PreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalCaption.App.Interview.Views"
             xmlns:prep="clr-namespace:LocalCaption.App.Interview.Views.Prep"
             AutomationProperties.Name="Interview preparation">

    <!-- SPEC-16 §5.2 Stage 1 — Preparation; Mac InterviewSetupSection.swift plus the footer of
         ActiveSessionView.preparationStage. Fills the window: no captions, transport or hotkeys.
         Top to bottom: Codex row, missing-skills banner, Interview details, ① ② ③ ④, model row,
         Start preparation, Start over; footer Skip preparation / Back to the interview.
         The DataContext is a PreparationViewModel set by PreparationView.Attach. -->

    <UserControl.Resources>
        <prep:PrepVisibility x:Key="Vis" />

        <Style x:Key="Prep.Box" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10,12,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Prep.BoxTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A multi-line box that shows its scroll bar (the JD box): the app's TextBox template
             hard-codes both bars hidden, so this one binds the vertical bar to the box's own
             VerticalScrollBarVisibility. As Settings.MultiLine (SettingsPageResources.xaml). -->
        <Style x:Key="Prep.MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text.Muted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label has no style in Controls.xaml: without this it is black on the dark theme. -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Prep.Note" TargetType="TextBlock" BasedOn="{StaticResource Type.Note}">
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style x:Key="Prep.Warn" TargetType="TextBlock" BasedOn="{StaticResource Prep.Note}">
            <Setter Property="Foreground" Value="{DynamicResource Caution}" />
        </Style>

        <!-- The Mac's link-style buttons (footer). Template.Button, so keyboard focus shows. -->
        <Style x:Key="Prep.LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="28" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ③ segments: radio buttons dressed as the toolbar chips. -->
        <Style x:Key="Prep.Segment" TargetType="RadioButton" BasedOn="{StaticResource Toggle.Chip}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="Prep.Stepper" TargetType="RepeatButton" BasedOn="{StaticResource Button.Step}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
            <Setter Property="Background" Value="{DynamicResource Bg.Input}" />
        </Style>

        <!-- A part's heading: numbered disc, title, and (at the right) running / stopped / done. -->
        <DataTemplate x:Key="PartHeader">
            <DockPanel AutomationProperties.Name="{Binding AccessibleName}">
                <Border x:Name="Disc" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10"
                        BorderThickness="1" VerticalAlignment="Top" Margin="0,0,8,0"
                        Background="{DynamicResource Bg.Hover}" BorderBrush="{DynamicResource Line.Strong}">
                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="10.5" FontWeight="Bold"
                               FontFamily="{StaticResource Font.Mono}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                </Border>
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top" MinHeight="20">
                    <prep:PrepSpinner VerticalAlignment="Center"
                                      Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                    <TextBlock Style="{StaticResource Type.Icon}" Text="&#xE7BA;" FontSize="13"
                               Foreground="{DynamicResource Caution}" AutomationProperties.Name="Stopped here"
                               Visibility="{Binding IsFailed, Converter={StaticResource Vis}}" />
                    <TextBlock Style="{StaticResource Type.Icon}" Text="&#xE73E;" FontSize="13"
                               Foreground="{DynamicResource Ok}" AutomationProperties.Name="Done"
                               Visibility="{Binding IsDone, Converter={StaticResource Vis}}" />
                </Grid>
                <TextBlock Style="{StaticResource Prep.BoxTitle}" Text="{Binding Title}" Margin="0,1,0,0" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Disc" Property="BorderBrush" Value="{DynamicResource Ok}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Ok}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Prep.PartHeading" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource PartHeader}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Footer: outside the scroll, always reachable. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Button x:Name="LeaveButton" Style="{StaticResource Prep.LinkButton}" HorizontalAlignment="Right"
                    Content="{Binding LeaveLabel}" ToolTip="{Binding LeaveToolTip}"
                    IsEnabled="{Binding CanLeave}" Click="OnLeave" />
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel MaxWidth="760" Margin="16,14,16,16">

                <!-- Codex: only when it blocks the interview (account details are in Settings → Codex). -->
                <Border Style="{StaticResource Prep.Box}"
                        Visibility="{Binding ShowCodexRow, Converter={StaticResource Vis}}">
                    <!-- Null until Attach sets CodexRow.Codex (the row then sets its own
                         DataContext): it must not inherit the PreparationViewModel meanwhile. -->
                    <views:CodexStatusRow x:Name="CodexRow" DataContext="{x:Null}" />
                </Border>

                <!-- Missing skills -->
                <Border Background="{DynamicResource Notice.Warn.Bg}" BorderBrush="{DynamicResource Notice.Warn.Line}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding ShowMissingSkills, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Type.Icon}" Text="&#xE7BA;"
                                   Foreground="{DynamicResource Caution}" VerticalAlignment="Top"
                                   Margin="0,2,10,0" AutomationProperties.Name="Warning" />
                        <StackPanel>
                            <TextBlock Text="Load your 4 skills before the interview" FontWeight="SemiBold"
                                       FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Prep.Note}" Margin="0,2,0,0" Text="{Binding MissingSkillsText}" />
                            <TextBlock FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Hyperlink Click="OnOpenSkills">Open Settings → Interview → Skills</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Interview details: name the session -->
                <Border Style="{StaticResource Prep.Box}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Prep.BoxTitle}" Text="Interview" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Content="_Interviewee" Target="{Binding ElementName=CandidateBox}"
                                   HorizontalAlignment="Right" Margin="0,0,10,6" />
                            <TextBox x:Name="CandidateBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Tag="Name"
                                     AutomationProperties.Name="Interviewee"
                                     Text="{Binding Candidate, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnDetailsCommitted" KeyDown="OnDetailsKeyDown" />

                            <Label Grid.Row="1" Content="Compan_y" Target="{Binding ElementName=CompanyBox}"
                                   HorizontalAlignment="Right" Margin="0,0,10,6" />
                            <TextBox x:Name="CompanyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Tag="Company"
                                     AutomationProperties.Name="Company"
                                     Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnDetailsCommitted" KeyDown="OnDetailsKeyDown" />

                            <Label Grid.Row="2" Content="St_ep" Target="{Binding ElementName=StepDown}"
                                   HorizontalAlignment="Right" Margin="0,0,10,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <RepeatButton x:Name="StepDown" Style="{StaticResource Prep.Stepper}" Tag="&#xE738;"
                                              Command="{Binding StepDownCommand}"
                                              AutomationProperties.Name="Previous step" ToolTip="Previous step" />
                                <TextBlock Text="{Binding StepText}" MinWidth="30" TextAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="13" />
                                <RepeatButton Style="{StaticResource Prep.Stepper}" Tag="&#xE710;"
                                              Command="{Binding StepUpCommand}"
                                              AutomationProperties.Name="Next step" ToolTip="Next step" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Prep.Note}" Margin="0,8,0,0" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SessionNameText}" ToolTip="{Binding SessionNameText}" />
                    </StackPanel>
                </Border>

                <!-- ① Discovery CV -->
                <Border Style="{StaticResource Prep.Box}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Prep.PartHeading}" Content="{Binding Part1}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="_Upload CV…"
                                    Click="OnUploadCv" />
                            <ComboBox x:Name="CvBox" AutomationProperties.Name="CV"
                                      ItemsSource="{Binding CvChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding CvSelection, Mode=TwoWay}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Prep.Warn}" Text="{Binding UploadError}"
                                   Visibility="{Binding UploadError, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <!-- ② Discovery JD -->
                <Border Style="{StaticResource Prep.Box}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Prep.PartHeading}" Content="{Binding Part2}" />
                        <Grid>
                            <TextBox x:Name="JdBox" AutomationProperties.Name="Job description"
                                     Style="{StaticResource Prep.MultiLine}"
                                     Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Paste the job description here" Margin="11,7,8,0" VerticalAlignment="Top"
                                       IsHitTestVisible="False" Foreground="{DynamicResource Text.Faint}"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Visibility="{Binding ShowJdPlaceholder, Converter={StaticResource Vis}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ③ Apply instruction -->
                <Border Style="{StaticResource Prep.Box}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Prep.PartHeading}" Content="{Binding Part3}" />
                        <UniformGrid Columns="3" Rows="1" HorizontalAlignment="Left" MaxWidth="390"
                                     AutomationProperties.Name="Mode">
                            <RadioButton Style="{StaticResource Prep.Segment}" Content="I_ntro"
                                         IsChecked="{Binding IsIntro, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Prep.Segment}" Content="_Tech"
                                         IsChecked="{Binding IsTech, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Prep.Segment}" Content="Be_havioral" Margin="0"
                                         IsChecked="{Binding IsBehavioral, Mode=TwoWay}" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Prep.Note}" Margin="0,6,0,0" Text="{Binding ProfileNote}" />
                    </StackPanel>
                </Border>

                <!-- ④ Live coding & design (optional) -->
                <Border Style="{StaticResource Prep.Box}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Prep.PartHeading}" Content="{Binding Part4}" />
                        <CheckBox IsChecked="{Binding LiveCoding, Mode=TwoWay}"
                                  AutomationProperties.Name="Use live coding and system design answers (needs the Tech mode)">
                            <AccessText TextWrapping="Wrap"
                                        Text="Use _live coding &amp; system design answers (needs the Tech mode)" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Model and effort: the same config keys as Settings → Interview -->
                <StackPanel Margin="0,4,0,10">
                    <DockPanel Margin="0,0,0,8">
                        <Label DockPanel.Dock="Left" Content="_Model" Target="{Binding ElementName=ModelBox}"
                               Margin="0,0,10,0" />
                        <ComboBox x:Name="ModelBox" AutomationProperties.Name="Model"
                                  ItemsSource="{Binding ModelChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ModelId, Mode=TwoWay}" />
                    </DockPanel>
                    <Grid x:Name="EffortGrid" SizeChanged="OnEffortGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EffortFirstColumn" Width="*" />
                            <ColumnDefinition x:Name="EffortGapColumn" Width="14" />
                            <ColumnDefinition x:Name="EffortSecondColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="EffortGapRow" Height="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Column="0" Grid.Row="0">
                            <Label DockPanel.Dock="Left" Content="_Preparation effort"
                                   Target="{Binding ElementName=PrepEffortBox}" Margin="0,0,10,0" />
                            <ComboBox x:Name="PrepEffortBox" AutomationProperties.Name="Preparation effort"
                                      ItemsSource="{Binding PrepEffortChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding PrepEffort, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel x:Name="AnswerEffortCell" Grid.Column="2" Grid.Row="0">
                            <Label DockPanel.Dock="Left" Content="_Answer effort"
                                   Target="{Binding ElementName=AnswerEffortBox}" Margin="0,0,10,0" />
                            <ComboBox x:Name="AnswerEffortBox" AutomationProperties.Name="Answer effort"
                                      ItemsSource="{Binding AnswerEffortChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding AnswerEffort, Mode=TwoWay}" />
                        </DockPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Prep.Note}" Margin="0,6,0,0"
                               Text="Low answer effort answers fastest. These are the same settings as Settings → Interview." />
                </StackPanel>

                <!-- Start preparation -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <DockPanel Visibility="{Binding Preparing, Converter={StaticResource Vis}}">
                            <prep:PrepSpinner DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RunningText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding IsFailed, Converter={StaticResource Vis}}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Type.Icon}" Text="&#xE7BA;"
                                       Foreground="{DynamicResource Caution}" Margin="0,0,8,0"
                                       AutomationProperties.Name="Warning" />
                            <TextBlock Text="{Binding FailedText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Caution}" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding ShowPreparedSeal, Converter={StaticResource Vis}}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Type.Icon}" Text="&#xE930;"
                                       Foreground="{DynamicResource Ok}" Margin="0,0,8,0" />
                            <TextBlock Text="Prepared" VerticalAlignment="Center" Foreground="{DynamicResource Ok}" />
                        </DockPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Accent}" Content="_Continue" MinWidth="96"
                                Command="{Binding ContinueCommand}"
                                Visibility="{Binding IsFailed, Converter={StaticResource Vis}}" />
                        <Button Content="Start o_ver" Margin="8,0,0,0" MinWidth="88"
                                ToolTip="Run the whole preparation again"
                                Command="{Binding RestartCommand}"
                                Visibility="{Binding IsFailed, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource Button.Accent}" Tag="&#xE768;" MinWidth="170" MinHeight="36"
                                Content="{Binding StartLabel}" Command="{Binding StartCommand}"
                                Visibility="{Binding IsIdle, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Prep.Note}" Text="{Binding Blocker}"
                           Visibility="{Binding ShowBlocker, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Prep.Warn}" Text="{Binding StatusText}"
                           Visibility="{Binding StatusText, Converter={StaticResource Vis}}" />
                <TextBlock Style="{StaticResource Prep.Warn}" Text="{Binding ModelNotice}"
                           Visibility="{Binding ModelNotice, Converter={StaticResource Vis}}" />

                <!-- Start over: discard an unstarted preparation -->
                <TextBlock HorizontalAlignment="Right" Margin="0,10,0,0" FontSize="12.5"
                           Visibility="{Binding ShowStartOver, Converter={StaticResource Vis}}">
                    <Hyperlink Click="OnStartOver" ToolTip="Discard this preparation and begin again">Start over</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
