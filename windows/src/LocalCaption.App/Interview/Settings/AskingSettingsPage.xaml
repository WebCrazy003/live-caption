<UserControl x:Class="LocalCaption.App.Interview.Settings.AskingSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalCaption.App.Interview.Settings"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalCaption;component/Interview/Settings/SettingsPageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Settings → Asking (specs/SPEC-16 §5.7, Mac InterviewSettingsSections .asking):
         Hotkeys, What to send, Screenshots. DataContext: InterviewSettingsModel. -->
    <StackPanel Style="{StaticResource Settings.Page}">
        <TextBlock Style="{StaticResource Type.Heading}" Text="Asking" />

        <!-- ── Hotkeys ── -->
        <TextBlock Style="{StaticResource Settings.Group}" Margin="0,0,0,2" Text="HOTKEYS" />
        <local:HotkeyRecorder Margin="0,10,0,0" Title="Ask hotkey"
                              Hotkey="{Binding Hotkey, Mode=TwoWay}" DefaultHotkey="F8"
                              OtherName="Screenshot" OtherHotkey="{Binding ScreenshotHotkey}" OtherDefaultHotkey="F9"
                              RegistrationError="{Binding AskRegistrationError}" />
        <local:HotkeyRecorder Margin="0,16,0,0" Title="Screenshot hotkey"
                              Hotkey="{Binding ScreenshotHotkey, Mode=TwoWay}" DefaultHotkey="F9"
                              OtherName="Ask" OtherHotkey="{Binding Hotkey}" OtherDefaultHotkey="F8"
                              RegistrationError="{Binding ScreenshotRegistrationError}" />
        <TextBlock Style="{StaticResource Type.Note}" Margin="0,10,0,0"
                   Text="Screenshot: drag to select an area of the screen; it's added to the current prompt and the next Ask or Send takes it. Esc cancels; Space captures the window under the pointer. LocalCaption hides while you select. Both hotkeys work in Interview mode, even while the call app has focus." />

        <!-- ── What to send ── -->
        <TextBlock Style="{StaticResource Settings.Group}" Text="WHAT TO SEND" />
        <TextBlock Style="{StaticResource Settings.Field}" Text="Send" />
        <StackPanel>
            <RadioButton Content="Everything since my last ask" Margin="0,0,0,8"
                         IsChecked="{Binding SendMode, Converter={StaticResource Equals}, ConverterParameter=since_last_ask}" />
            <RadioButton Content="{Binding LatestSentencesLabel}"
                         IsChecked="{Binding SendMode, Converter={StaticResource Equals}, ConverterParameter=last_sentences}" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsLastSentences, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Settings.Field}" Text="Sentences" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Type.Measure}" Margin="12,0,0,0" MinWidth="64"
                           Text="{Binding SendSentencesText}" />
                <Slider Minimum="1" Maximum="20" SmallChange="1" LargeChange="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="{Binding SendSentences}"
                        AutomationProperties.Name="Sentences" />
            </DockPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Settings.Field}" Text="At most" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Type.Measure}" Margin="12,0,0,0" MinWidth="64"
                       Text="{Binding MaxWordsText}" />
            <Slider Minimum="50" Maximum="2000" SmallChange="50" LargeChange="250" TickFrequency="50"
                    IsSnapToTickEnabled="True" Value="{Binding MaxWords}"
                    AutomationProperties.Name="At most (words)" />
        </DockPanel>

        <TextBlock Style="{StaticResource Settings.Field}" Text="While an answer is still coming" />
        <ComboBox ItemsSource="{Binding BusyPolicies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding BusyPolicy}" AutomationProperties.Name="While an answer is still coming" />
        <TextBlock Style="{StaticResource Type.Note}" Margin="0,6,0,0"
                   Text="The live, not-yet-final caption line is always included, so you can press right as the interviewer stops." />

        <!-- ── Screenshots ── -->
        <TextBlock Style="{StaticResource Settings.Group}" Text="SCREENSHOTS" />
        <CheckBox Content="Add screenshots to the current prompt automatically" Margin="0,12,0,0"
                  IsChecked="{Binding IncludeClipboardImages}" />
        <CheckBox Content="Clear the screenshot from the clipboard after sending" Margin="0,10,0,0"
                  IsChecked="{Binding ClearClipboardImagesAfterSend}"
                  IsEnabled="{Binding IncludeClipboardImages}" />
        <TextBlock Style="{StaticResource Type.Note}" Margin="0,8,0,0" Text="{Binding ScreenshotsNote}" />
    </StackPanel>
</UserControl>
