<UserControl x:Class="LocalCaption.App.Interview.Answers.AnswerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:answers="clr-namespace:LocalCaption.App.Interview.Answers"
             Focusable="False">

    <!-- One turn (Mac AnswerCard): collapsed to its "Q: …" line, or expanded with the answer,
         its state, time to first words, What was sent, Regenerate and Copy answer. -->
    <Grid>
        <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Line}" />
        <!-- The newest card is tinted brass, as the Mac tints it with the accent colour. -->
        <Border x:Name="LatestTint" CornerRadius="8" Background="{DynamicResource Accent}" Opacity="0.07"
                IsHitTestVisible="False" Visibility="Collapsed" />

        <StackPanel Margin="10,8,10,8">

            <!-- Collapsed: chevron · summary line · status badge. The whole row toggles. -->
            <Button x:Name="CollapsedRow" Style="{DynamicResource Answers.PlainButton}" Click="OnToggle"
                    AutomationProperties.HelpText="Show the answer">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                               Text="&#xE76C;" VerticalAlignment="Center" Margin="0,1,8,0"
                               Foreground="{DynamicResource Text.Muted}" />
                    <StackPanel x:Name="CollapsedBadge" DockPanel.Dock="Right" Orientation="Horizontal"
                                Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" />
                </DockPanel>
            </Button>

            <StackPanel x:Name="ExpandedBody">
                <!-- Older expanded cards can be folded again; the newest always stays open. -->
                <Button x:Name="CollapseRow" Style="{DynamicResource Answers.PlainButton}" Click="OnToggle"
                        Margin="0,0,0,4" AutomationProperties.Name="Collapse" ToolTip="Collapse">
                    <TextBlock FontFamily="{DynamicResource Font.Icon}" FontSize="10" Text="&#xE70D;"
                               HorizontalAlignment="Left" Foreground="{DynamicResource Text.Muted}" />
                </Button>

                <TextBlock x:Name="QuestionText" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight" LineHeight="16" MaxHeight="32"
                           Margin="0,0,0,6" Foreground="{DynamicResource Text.Muted}" />

                <StackPanel x:Name="ThinkingRow" Orientation="Horizontal" Margin="0,2,0,2">
                    <ProgressBar IsIndeterminate="True" Width="36" Height="3" BorderThickness="0"
                                 VerticalAlignment="Center" Focusable="False"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" />
                    <TextBlock Text="Thinking…" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" />
                </StackPanel>

                <answers:MarkdownView x:Name="Answer" />

                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                    <StackPanel x:Name="ExpandedBadge" DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" />
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{DynamicResource Answers.IconButton}"
                            Tag="&#xE8C8;" Click="OnCopy" ToolTip="Copy answer" AutomationProperties.Name="Copy answer" />
                    <Button x:Name="RegenerateButton" DockPanel.Dock="Right" Style="{DynamicResource Answers.IconButton}"
                            Tag="&#xE72C;" Click="OnRegenerate" ToolTip="Give me a different answer"
                            AutomationProperties.Name="Regenerate" />
                    <Button x:Name="SentButton" DockPanel.Dock="Right" Style="{DynamicResource Answers.IconButton}"
                            Tag="&#xE8BD;" Click="OnSent" ToolTip="What was sent"
                            AutomationProperties.Name="What was sent" />
                    <TextBlock x:Name="TtftText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="10.5" ToolTip="Time to first words" Foreground="{DynamicResource Text.Faint}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <!-- What was sent: the text and any screenshots (read from the interview database). -->
        <Popup x:Name="SentPopup" PlacementTarget="{Binding ElementName=SentButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Closed="OnSentClosed" Opened="OnSentOpened">
            <Border Style="{DynamicResource Answers.PopupSurface}" Width="360" Height="300" Padding="0"
                    KeyDown="OnSentKey">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="14,12" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="Sent" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Text}" />
                        <TextBox x:Name="SentText" Style="{DynamicResource Answers.ReadOnlyText}" FontSize="12.5"
                                 AutomationProperties.Name="Sent text" />
                        <StackPanel x:Name="SentImages" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
