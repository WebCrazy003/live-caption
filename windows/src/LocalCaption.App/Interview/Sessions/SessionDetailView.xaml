<UserControl x:Class="LocalCaption.App.Interview.Sessions.SessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalCaption.App.Interview.Sessions"
             Focusable="False">

    <!-- Sessions window → the selected session (specs/SPEC-16 §5.6, Mac SessionDetailView):
         name, created · duration, actions, the interview's details, then the read-only
         replay (interviews) or the transcript rebuilt from session_segments (captions). -->
    <Grid>
        <!-- Nothing selected / not found. -->
        <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="24" Visibility="Collapsed">
            <TextBlock x:Name="PlaceholderGlyph" Style="{StaticResource Type.Icon}" FontSize="34"
                       Foreground="{DynamicResource Text.Faint}" Text="&#xE8FD;" />
            <TextBlock x:Name="PlaceholderText" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Text.Muted}" />
        </StackPanel>

        <DockPanel x:Name="Body" Margin="20,16,20,14">

            <!-- Header: name, created · duration. -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="NameText" FontFamily="{StaticResource Font.Display}" FontSize="18"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WhenText" Style="{StaticResource Type.Measure}" Margin="0,4,0,0"
                           Foreground="{DynamicResource Text.Muted}" />
            </StackPanel>

            <!-- Actions. The right-hand pair docks first, so at the 720 px minimum the open
                 button and its blocker wrap underneath rather than push them off. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ShowInFolderButton" Content="Show in folder" Tag="&#xE838;"
                            Click="OnShowInFolder" ToolTip="Show the transcript file in File Explorer" />
                    <Button x:Name="DeleteButton" Content="Delete…" Tag="&#xE74D;" Margin="8,0,0,0"
                            Style="{StaticResource Button.Danger}" Click="OnDelete"
                            ToolTip="Delete this session" />
                </StackPanel>
                <WrapPanel x:Name="OpenRow" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="OpenButton" Content="Open in Interview Panel" Tag="&#xE8A7;"
                            Style="{StaticResource Button.Accent}" Click="OnOpen"
                            ToolTipService.ShowOnDisabled="True" />
                    <TextBlock x:Name="BlockerText" Style="{StaticResource Type.Note}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>

            <!-- Interviewee, Company, Step, Role, Mode, CV, Model · effort, Questions — two
                 pairs to a row, empty ones left out (Mac). -->
            <ItemsControl x:Name="Details" DockPanel.Dock="Top" Margin="0,14,0,0" Focusable="False"
                          Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,16,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DetailLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Margin="0,0,12,0"
                                       Foreground="{DynamicResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border DockPanel.Dock="Top" Height="1" Margin="0,14,0,8" Background="{DynamicResource Line}" />

            <!-- Exactly one of these is visible. -->
            <Grid>
                <ContentPresenter x:Name="ReplaySlot" Focusable="False" />
                <local:TranscriptTextView x:Name="Transcript"
                                          AutomationProperties.Name="Transcript" />
                <StackPanel x:Name="EmptyTranscript" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Type.Icon}" FontSize="34" Text="&#xE8A5;"
                               Foreground="{DynamicResource Text.Faint}" />
                    <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Text.Muted}" TextAlignment="Center"
                               TextWrapping="Wrap" Text="No captions were saved for this session." />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
