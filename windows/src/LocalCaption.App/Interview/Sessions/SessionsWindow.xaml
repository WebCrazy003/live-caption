<app:ChromeWindow x:Class="LocalCaption.App.Interview.Sessions.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:LocalCaption.App"
        xmlns:local="clr-namespace:LocalCaption.App.Interview.Sessions"
        Title="Sessions" Width="980" Height="640" MinWidth="720" MinHeight="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">

    <!-- specs/SPEC-16 §5.6 (Mac SessionsWindow + SessionListView): every saved session on
         the left, the selected one's details on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" MaxWidth="480" />
            <ColumnDefinition Width="*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12,12,12,8" Tag="Search sessions"
                         AutomationProperties.Name="Search sessions" TextChanged="OnSearchChanged" />
                <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ShowBox" Tag="SHOW" DisplayMemberPath="Label"
                              AutomationProperties.Name="Show" SelectionChanged="OnQueryChanged" />
                    <ComboBox x:Name="SortBox" Grid.Column="2" Tag="SORT" DisplayMemberPath="Label"
                              AutomationProperties.Name="Sort by" SelectionChanged="OnQueryChanged" />
                </Grid>

                <Grid>
                    <ListBox x:Name="List" Margin="6,0,4,6" SelectionMode="Single"
                             AutomationProperties.Name="Sessions"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKey">
                        <!-- Right-clicking does not select in WPF; without this the menu would
                             act on the previous selection. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Base}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemRightClicked" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="OnMenuOpened">
                                <MenuItem x:Name="MenuRename" Header="Rename…" InputGestureText="F2" Click="OnRename" />
                                <MenuItem x:Name="MenuShow" Header="Show in folder" Click="OnShowInFolder" />
                                <Separator />
                                <MenuItem x:Name="MenuDelete" Header="Delete…" InputGestureText="Del" Click="OnDelete" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SessionRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Briefcase: an interview. -->
                                    <TextBlock x:Name="Kind" Style="{StaticResource Type.Icon}" FontSize="12"
                                               Margin="0,1,6,0" Text="&#xE821;" ToolTip="Interview"
                                               Foreground="{DynamicResource Text.Muted}" Visibility="Collapsed" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <!-- Duration column. -->
                                    <TextBlock Grid.Column="2" Style="{StaticResource Type.Measure}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Text.Muted}" Text="{Binding Duration}" />

                                    <TextBlock x:Name="Subtitle" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Style="{StaticResource Type.Muted}" FontSize="11.5" Margin="0,2,0,0"
                                               Text="{Binding Subtitle}" Visibility="Collapsed" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                               Style="{StaticResource Type.Muted}" FontSize="11" Margin="0,2,0,0"
                                               Text="{Binding When}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsInterview}" Value="True">
                                        <Setter TargetName="Kind" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSubtitle}" Value="True">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyList" Style="{StaticResource Type.Note}" Margin="14,10"
                               HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                               Text="No sessions yet" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" />

        <local:SessionDetailView x:Name="Detail" Grid.Column="1" />
    </Grid>
</app:ChromeWindow>
