<local:ChromeWindow x:Class="LocalCaption.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalCaption.App"
        Title="Local Caption" Height="620" Width="980" AllowSeeThrough="True">

    <!-- The title bar carries the controls that must survive any window size. Whatever the
         body does when it is squeezed beside a video call — wrap, scroll, drop the sidebar —
         Settings, the theme and the pin stay exactly where they were. -->
    <local:ChromeWindow.TitleBarLeading>
        <Button x:Name="SidebarButton" Style="{StaticResource Button.Ghost}" Tag="&#xE89F;"
                Click="OnToggleSidebar" Focusable="False" />
    </local:ChromeWindow.TitleBarLeading>

    <local:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <!-- Text size and see-through live behind one button: two sliders that are wanted
                 a few times a session do not earn permanent room beside the captions. -->
            <ToggleButton x:Name="ViewButton" Style="{StaticResource Toggle.Ghost}" Tag="&#xE8D2;"
                          Checked="OnViewChecked" Unchecked="OnViewUnchecked" Focusable="False" Margin="0,0,2,0" />
            <Popup x:Name="ViewPopup" Placement="Bottom" HorizontalOffset="-196" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnViewClosed">
                <Border Width="264" Margin="8,0,10,14" Padding="16,14,16,14" CornerRadius="8"
                        Background="{DynamicResource Bg.Raised}" BorderThickness="1"
                        BorderBrush="{DynamicResource Line.Strong}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4"
                                          Color="{DynamicResource Shadow.Color}" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="FontValue" DockPanel.Dock="Right" Style="{StaticResource Type.Measure}"
                                       Foreground="{DynamicResource Text}" Text="18 pt" />
                            <TextBlock Style="{StaticResource Type.Caps}" Text="TEXT SIZE" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="A" FontSize="11" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="{DynamicResource Text.Muted}" />
                            <TextBlock DockPanel.Dock="Right" Text="A" FontSize="19" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Foreground="{DynamicResource Text.Muted}" />
                            <Slider x:Name="FontSlider" Minimum="12" Maximum="32" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="OnFontSlid" />
                        </DockPanel>

                        <DockPanel Margin="0,16,0,0">
                            <TextBlock x:Name="SeeThroughValue" DockPanel.Dock="Right"
                                       Style="{StaticResource Type.Measure}"
                                       Foreground="{DynamicResource Text}" Text="0%" />
                            <TextBlock Style="{StaticResource Type.Caps}" Text="SEE-THROUGH" />
                        </DockPanel>
                        <Slider x:Name="SeeThroughSlider" Minimum="0" Maximum="90" Margin="0,6,0,0"
                                SmallChange="5" LargeChange="10" ValueChanged="OnSeeThroughSlid" />
                        <TextBlock Style="{StaticResource Type.Note}" Margin="0,8,0,0"
                                   Text="Only the background fades — the words stay solid, so captions can sit over the call. Pin the window to keep it on top." />
                    </StackPanel>
                </Border>
            </Popup>
            <ToggleButton x:Name="ClickThroughButton" Style="{StaticResource Toggle.Ghost}" Tag="&#xE8B0;"
                          Checked="OnClickThroughChecked" Unchecked="OnClickThroughChecked" Focusable="False" Margin="0,0,2,0" />
            <ToggleButton x:Name="PinButton" Style="{StaticResource Toggle.Ghost}" Tag="&#xE718;"
                          Click="OnTogglePin" Focusable="False" />
            <Button x:Name="ThemeButton" Style="{StaticResource Button.Ghost}" Tag="&#xE706;"
                    Click="OnToggleTheme" Focusable="False" Margin="2,0,0,0" />
            <Button x:Name="SettingsButton" Style="{StaticResource Button.Ghost}" Tag="&#xE713;"
                    Click="OnSettings" Focusable="False" Margin="2,0,0,0" />
            <Border Width="1" Height="16" Margin="8,0,2,0" Background="{DynamicResource Line.Strong}" />
        </StackPanel>
    </local:ChromeWindow.TitleBarContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Session list (§7.1). The detail pane is the active session. -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True">
                <DockPanel x:Name="SidebarContent">
                    <DockPanel DockPanel.Dock="Top" Margin="14,8,6,6">
                        <!-- The panel can be closed from the panel. The title-bar button is the
                             way back, but nobody looks there for how to make a list go away. -->
                        <Button x:Name="SidebarCloseButton" DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                                Tag="&#xE76B;" Width="26" Height="24" Click="OnToggleSidebar" Focusable="False" />
                        <TextBlock x:Name="SessionCount" DockPanel.Dock="Right" Style="{StaticResource Type.Caps}"
                                   Foreground="{DynamicResource Text.Faint}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Type.Caps}" Text="SESSIONS" />
                    </DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12,0,12,6" Tag="Search"
                             TextChanged="OnSearchChanged" />
                    <ComboBox x:Name="SortBox" DockPanel.Dock="Top" Margin="12,0,12,8" Tag="SORT"
                              SelectionChanged="OnSortChanged" DisplayMemberPath="Label" />
                    <TextBlock x:Name="EmptyList" DockPanel.Dock="Top" Style="{StaticResource Type.Note}"
                               Margin="14,8" Text="No saved sessions yet. Press Start to record one." />
                    <ListBox x:Name="SessionList" Margin="6,0,4,6" MouseDoubleClick="OnOpenTranscript"
                             KeyDown="OnSessionKey">
                        <!-- Right-clicking a ListBox item does not select it in WPF, so the context
                             menu would act on whatever was selected before — or on nothing. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Base}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemRightClicked" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open transcript" Click="OnOpenSelected" />
                                <MenuItem Header="Show in folder" Click="OnShowInFolder" />
                                <Separator />
                                <MenuItem Header="Rename…" Click="OnRename" />
                                <MenuItem Header="Remove…" Click="OnDelete" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding SessionName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Type.Muted}" FontSize="11" Margin="0,2,0,0"
                                               Text="{Binding When, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="0" Width="5" HorizontalAlignment="Right"
                          VerticalAlignment="Stretch" DragCompleted="OnSidebarResized" />

            <DockPanel Grid.Column="1" Margin="16,14,16,12">

                <!-- Active Session header: name, elapsed, and the two things §4.7.5 promotes
                     from polish to requirements — the live level meter and the source name. -->
                <Grid x:Name="HeaderGrid" DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock x:Name="SessionTitle" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Display}"
                                   Text="New Session" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse x:Name="PhaseDot" Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource Text.Faint}" />
                            <TextBlock x:Name="PhaseText" Style="{StaticResource Type.Muted}" Text="Preparing…" />
                            <TextBlock Style="{StaticResource Type.Muted}" Text="  ·  " />
                            <TextBlock x:Name="SourceText" Style="{StaticResource Type.Muted}" MaxWidth="320"
                                       Text="no source" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="ElapsedText" FontSize="24" FontFamily="{StaticResource Font.Mono}"
                                   Text="00:00:00" HorizontalAlignment="Right" />
                        <!-- The VU bar. The worst outcome of the whole remote setup is
                             recording forty minutes of silence because the wrong source was
                             captured; this makes that impossible to miss. -->
                        <Border x:Name="LevelTrack" Width="150" Height="6" Margin="0,7,0,0"
                                Background="{DynamicResource Line}"
                                CornerRadius="3" HorizontalAlignment="Right">
                            <Rectangle x:Name="LevelBar" Fill="{DynamicResource Ok}" HorizontalAlignment="Left"
                                       Width="0" RadiusX="3" RadiusY="3" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Quick toolbar. Everything here saves the moment it changes, so a model or a
                     source can be swapped mid-call without opening Settings. It scrolls sideways
                     rather than wrapping — five rows of chips in a narrow window would cost the
                     captions more than they are worth — so the order is the order of need: what
                     gets changed mid-call first, what is set once and left alone last. -->
                <ScrollViewer x:Name="QuickScroll" DockPanel.Dock="Top" Margin="0,0,0,8"
                              Style="{StaticResource Scroll.Quiet}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnQuickWheel" ScrollChanged="OnQuickScrolled"
                              Focusable="False">
                    <StackPanel x:Name="QuickBar" Orientation="Horizontal" Margin="0,0,0,2">
                        <StackPanel.Resources>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="Margin" Value="0,0,5,0" />
                                <Setter Property="Padding" Value="8,0,6,0" />
                                <Setter Property="FontSize" Value="11.5" />
                            </Style>
                        </StackPanel.Resources>

                        <ComboBox x:Name="SourceBox" Tag="SOURCE" MaxWidth="220" DisplayMemberPath="Label"
                                  DropDownOpened="OnSourceOpening" SelectionChanged="OnQuickSourceChanged" />
                        <ComboBox x:Name="InterimBox" Tag="LIVE" DisplayMemberPath="Label"
                                  DropDownOpened="OnModelsOpening" SelectionChanged="OnQuickModelChanged" />
                        <ComboBox x:Name="FinalBox" Tag="FINAL" DisplayMemberPath="Label"
                                  DropDownOpened="OnModelsOpening" SelectionChanged="OnQuickModelChanged" />

                        <Border x:Name="CopyChip" Height="24" Margin="0,0,5,0" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Line.Strong}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Type.Caps}" Text="COPY N" Margin="8,0,3,0" />
                                <RepeatButton Style="{StaticResource Button.Step}" Tag="&#xE738;" Click="OnCopyFewer"
                                              Focusable="False" />
                                <TextBlock x:Name="CopyValue" Style="{StaticResource Type.Measure}" Text="10"
                                           MinWidth="18" TextAlignment="Center" Foreground="{DynamicResource Text}" />
                                <RepeatButton Style="{StaticResource Button.Step}" Tag="&#xE710;" Click="OnCopyMore"
                                              Focusable="False" Margin="0,0,2,0" />
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="FollowToggle" Style="{StaticResource Toggle.Chip}" Tag="&#xE74B;"
                                      Content="Follow" Margin="0,0,6,0" Click="OnQuickFollow" Focusable="False" />
                        <ToggleButton x:Name="AutoCopyToggle" Style="{StaticResource Toggle.Chip}" Tag="&#xE77F;"
                                      Content="Auto-copy" Margin="0,0,6,0" Click="OnQuickAutoCopy" Focusable="False" />
                        <ComboBox x:Name="SensitivityBox" Tag="DETECT" DisplayMemberPath="Label"
                                  SelectionChanged="OnQuickSensitivityChanged" />
                        <ComboBox x:Name="BackendBox" Tag="COMPUTE" SelectionChanged="OnQuickModelChanged" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Controls. A WrapPanel, so a narrow window gets a second row rather than
                     buttons that have slid out of reach. -->
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,-6">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="0,0,8,6" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button x:Name="StartButton" Style="{StaticResource Button.Accent}" Margin="0,0,8,6"
                            Tag="&#xE768;" Content="Start" Click="OnStart" MinWidth="92" />
                    <Button x:Name="PauseButton" Tag="&#xE769;" Content="Pause" Click="OnPauseResume"
                            IsEnabled="False" MinWidth="92" />
                    <Button x:Name="StopButton" Style="{StaticResource Button.Danger}" Margin="0,0,8,6"
                            Tag="&#xE71A;" Content="Stop" Click="OnStop" IsEnabled="False" MinWidth="80" />
                    <Button x:Name="QuestionButton" Tag="&#xE897;" Content="Copy question" Click="OnCopyQuestion"
                            IsEnabled="False" />
                    <Button x:Name="SendButton" Tag="&#xE724;" Content="Send question" Click="OnSendQuestion"
                            IsEnabled="False" Visibility="Collapsed" />
                    <Button x:Name="CopyButton" Tag="&#xE8C8;" Content="Copy last 10" Click="OnCopy"
                            IsEnabled="False" />
                    <Button x:Name="CopyAllButton" Tag="&#xE8A5;" Content="Copy all" Click="OnCopyAll"
                            IsEnabled="False" />
                    <Button x:Name="BookmarkButton" Tag="&#xE734;" Click="OnBookmark" IsEnabled="False"
                            MinWidth="36" Padding="10,0" />
                </WrapPanel>

                <!-- Status strip: model progress, capture warnings, save errors (§7.1) -->
                <Border DockPanel.Dock="Bottom" x:Name="StatusStrip" Padding="12,8" Margin="0,10,0,0"
                        CornerRadius="5" BorderThickness="1" Visibility="Collapsed"
                        Background="{DynamicResource Notice.Warn.Bg}"
                        BorderBrush="{DynamicResource Notice.Warn.Line}">
                    <DockPanel>
                        <TextBlock x:Name="StatusIcon" DockPanel.Dock="Left" Style="{StaticResource Type.Icon}"
                                   Text="&#xE7BA;" Margin="0,1,10,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Caution}" />
                        <!-- A first launch downloads up to 1.7 GB of speech models. A percentage
                             in a sentence is easy to miss; a bar that moves is not. -->
                        <Border x:Name="DownloadTrack" DockPanel.Dock="Bottom" Height="3" Margin="0,8,0,1"
                                CornerRadius="1.5" Background="{DynamicResource Line.Strong}"
                                Visibility="Collapsed">
                            <Border x:Name="DownloadFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5"
                                    Background="{DynamicResource Accent}" />
                        </Border>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5" />
                    </DockPanel>
                </Border>

                <Grid>
                    <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10,4,10">
                        <local:CaptionTextView x:Name="Captions" FontFamily="Segoe UI" FontSize="18">
                            <local:CaptionTextView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy last question" Click="OnCopyQuestion" />
                                    <MenuItem Header="Copy selection" Click="OnCopySelection" />
                                    <MenuItem Header="Copy last N sentences" Click="OnCopy" />
                                    <MenuItem Header="Copy whole transcript" Click="OnCopyAll" />
                                    <Separator />
                                    <MenuItem Header="Bookmark this moment" Click="OnBookmark" />
                                    <MenuItem Header="Jump to latest" Click="OnJump" />
                                </ContextMenu>
                            </local:CaptionTextView.ContextMenu>
                        </local:CaptionTextView>
                    </Border>
                    <TextBlock x:Name="CaptionPlaceholder" Style="{StaticResource Type.Muted}"
                               Margin="18,12" FontSize="18" IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Faint}"
                               Text="Play some audio…" />
                    <Button x:Name="JumpButton" Style="{StaticResource Button.Accent}" Tag="&#xE74B;"
                            Content="Jump to latest" Click="OnJump"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,22,14" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Instrument readout. How fast the two models are actually running, in the one
             place it can be glanced at without taking attention off the call. -->
        <Border Grid.Row="1" Height="26" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="CopiedFlag" Style="{StaticResource Type.Measure}" Visibility="Collapsed"
                               Foreground="{DynamicResource Ok}" Text="✓ COPIED" Margin="0,0,14,0" />
                    <TextBlock x:Name="EngineText" Style="{StaticResource Type.Measure}"
                               Foreground="{DynamicResource Text.Muted}" Text="" />
                </StackPanel>

                <StackPanel x:Name="SpeedPanel" Orientation="Horizontal" ClipToBounds="True">
                    <StackPanel.Resources>
                        <Style x:Key="Name" TargetType="TextBlock" BasedOn="{StaticResource Type.Caps}">
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                        </Style>
                        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Type.Measure}">
                            <Setter Property="Margin" Value="0,0,16,0" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Style="{StaticResource Name}" Text="LIVE" />
                    <TextBlock x:Name="SpeedLive" Style="{StaticResource Value}" Text="—" />
                    <TextBlock Style="{StaticResource Name}" Text="FINAL" />
                    <TextBlock x:Name="SpeedFinal" Style="{StaticResource Value}" Text="—" />
                    <TextBlock Style="{StaticResource Name}" Text="LAG" />
                    <TextBlock x:Name="SpeedLag" Style="{StaticResource Value}" Text="—" />
                    <TextBlock Style="{StaticResource Name}" Text="SPEED" />
                    <TextBlock x:Name="SpeedFactor" Style="{StaticResource Value}" Text="—" />
                    <!-- Only while it is doing something: the audio arrived quiet and is being
                         brought up. Seeing "+16 dB" is how you learn your volume is low. -->
                    <TextBlock x:Name="GainName" Style="{StaticResource Name}" Text="BOOST" Visibility="Collapsed" />
                    <TextBlock x:Name="GainValue" Style="{StaticResource Value}" Text="" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</local:ChromeWindow>
