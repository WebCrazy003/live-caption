<Window x:Class="LocalCaption.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalCaption.App"
        Title="Local Caption" Height="620" Width="980"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B70" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Session list (§7.1). The detail pane is the active session. -->
        <DockPanel Grid.Column="0" Background="#F5F5F7">
            <TextBlock DockPanel.Dock="Top" Text="Sessions" FontWeight="SemiBold"
                       Margin="14,14,14,8" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="14,0,14,6" Padding="6,4"
                     TextChanged="OnSearchChanged" />
            <ComboBox x:Name="SortBox" DockPanel.Dock="Top" Margin="14,0,14,8" Padding="6,3"
                      SelectionChanged="OnSortChanged" DisplayMemberPath="Label" />
            <TextBlock x:Name="EmptyList" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                       Margin="14,8" TextWrapping="Wrap"
                       Text="No saved sessions yet. Press Start to record one." />
            <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent"
                     Margin="6,0,6,6" MouseDoubleClick="OnOpenTranscript">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open transcript" Click="OnOpenSelected" />
                        <MenuItem Header="Show in folder" Click="OnShowInFolder" />
                        <Separator />
                        <MenuItem Header="Rename…" Click="OnRename" />
                        <MenuItem Header="Delete" Click="OnDelete" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4">
                            <TextBlock Text="{Binding SessionName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                <Run Text="{Binding CreatedAt, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="#E3E3E6" />

        <DockPanel Grid.Column="2" Margin="16">

            <!-- Active Session header: name, elapsed, and the two things §4.7.5 promotes
                 from polish to requirements — the live level meter and the source name. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SessionTitle" FontSize="17" FontWeight="SemiBold"
                               Text="New Session" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PhaseText" Style="{StaticResource Muted}" Text="Preparing…" />
                        <TextBlock Style="{StaticResource Muted}" Text="  ·  " />
                        <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" MaxWidth="320"
                                   Text="no source" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="ElapsedText" FontSize="24" FontFamily="Consolas"
                               Text="00:00:00" HorizontalAlignment="Right" />
                    <!-- The 20px VU bar. The worst outcome of the whole remote setup is
                         recording forty minutes of silence because the wrong source was
                         captured; this makes that impossible to miss. -->
                    <Border Width="160" Height="8" Margin="0,6,0,0" Background="#E3E3E6"
                            CornerRadius="4" HorizontalAlignment="Right">
                        <Rectangle x:Name="LevelBar" Fill="#2F855A" HorizontalAlignment="Left"
                                   Width="0" RadiusX="4" RadiusY="4" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Controls -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="StartButton" Content="Start" Click="OnStart" IsDefault="True" />
                <Button x:Name="PauseButton" Content="Pause" Click="OnPauseResume" IsEnabled="False" />
                <Button x:Name="StopButton" Content="Stop" Click="OnStop" IsEnabled="False" />
                <Button x:Name="CopyButton" Content="Copy last N" Click="OnCopy" IsEnabled="False" />
                <Button Content="Settings" Click="OnSettings" />
                <TextBlock x:Name="CopiedFlag" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Visibility="Collapsed" Text="Copied" />
            </StackPanel>

            <!-- Status strip: model progress, capture warnings, save errors (§7.1) -->
            <Border DockPanel.Dock="Bottom" x:Name="StatusStrip" Background="#FFF4CE"
                    Padding="10,6" Margin="0,10,0,0" CornerRadius="4" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Border BorderBrush="#E3E3E6" BorderThickness="1" CornerRadius="4" Padding="10">
                    <local:CaptionTextView x:Name="Captions" FontFamily="Segoe UI" FontSize="18" />
                </Border>
                <TextBlock x:Name="CaptionPlaceholder" Style="{StaticResource Muted}"
                           Margin="22,18" FontSize="18" IsHitTestVisible="False"
                           Text="Play some audio…" />
                <Button x:Name="JumpButton" Content="Jump to latest" Click="OnJump"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,18,14" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
