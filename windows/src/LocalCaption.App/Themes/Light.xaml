<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Day. Warm paper rather than white: ground and panel are kept visibly apart, because
         two percent between them flattens the whole window into one sheet. -->

    <!-- Grounds, lowest to highest -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F6F3EA" />
    <SolidColorBrush x:Key="Bg.Panel" Color="#ECE8DB" />
    <SolidColorBrush x:Key="Bg.Surface" Color="#FCFAF5" />
    <SolidColorBrush x:Key="Bg.Raised" Color="#FCFAF5" />
    <SolidColorBrush x:Key="Bg.Input" Color="#FCFAF5" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#E3DECE" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#D8D2BF" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#DFD9C8" />

    <!-- Hairlines -->
    <SolidColorBrush x:Key="Line" Color="#D9D3C2" />
    <SolidColorBrush x:Key="Line.Strong" Color="#B8B09A" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text" Color="#1F1D18" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#47433A" />
    <SolidColorBrush x:Key="Text.Muted" Color="#6B6658" />
    <SolidColorBrush x:Key="Text.Faint" Color="#9A9484" />
    <SolidColorBrush x:Key="Text.Provisional" Color="#7E929A" />

    <!-- Brass, darkened until it holds contrast on paper -->
    <SolidColorBrush x:Key="Accent" Color="#8A6424" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#2E8A6424" />
    <SolidColorBrush x:Key="Accent.SoftHover" Color="#478A6424" />
    <SolidColorBrush x:Key="Accent.Border" Color="#A68A6424" />
    <SolidColorBrush x:Key="Accent.Text" Color="#3F2D0C" />

    <!-- Instrument readouts -->
    <SolidColorBrush x:Key="Live" Color="#1B7893" />
    <SolidColorBrush x:Key="Ok" Color="#0F7F6F" />
    <SolidColorBrush x:Key="Caution" Color="#94660F" />
    <SolidColorBrush x:Key="Danger" Color="#C2414B" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#26C2414B" />

    <!-- Notices -->
    <SolidColorBrush x:Key="Notice.Warn.Bg" Color="#FBF0CF" />
    <SolidColorBrush x:Key="Notice.Warn.Line" Color="#E2CC88" />
    <SolidColorBrush x:Key="Notice.Error.Bg" Color="#FBE3E4" />
    <SolidColorBrush x:Key="Notice.Error.Line" Color="#E8A8AD" />

    <SolidColorBrush x:Key="Selection" Color="#598A6424" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#C9C2AE" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#A39B84" />
    <SolidColorBrush x:Key="Close.Hover" Color="#C42B1C" />

    <Color x:Key="Shadow.Color">#3A3425</Color>

</ResourceDictionary>
