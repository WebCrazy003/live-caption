<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Night. A near-black ground with warm bone text and a brass active edge.
         Every key here exists in Light.xaml too; controls only ever name the role. -->

    <!-- Grounds, lowest to highest -->
    <SolidColorBrush x:Key="Bg.Window" Color="#0A0C10" />
    <SolidColorBrush x:Key="Bg.Panel" Color="#0E1116" />
    <SolidColorBrush x:Key="Bg.Surface" Color="#0E1116" />
    <SolidColorBrush x:Key="Bg.Raised" Color="#161A21" />
    <SolidColorBrush x:Key="Bg.Input" Color="#11151B" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#1A1F28" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#232A35" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#1F242D" />

    <!-- Hairlines -->
    <SolidColorBrush x:Key="Line" Color="#222833" />
    <SolidColorBrush x:Key="Line.Strong" Color="#374050" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text" Color="#E8E0CC" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#BDB6A4" />
    <SolidColorBrush x:Key="Text.Muted" Color="#8F8A7D" />
    <SolidColorBrush x:Key="Text.Faint" Color="#5F5D56" />
    <SolidColorBrush x:Key="Text.Provisional" Color="#71858E" />

    <!-- Brass: the one colour that means "this is the active thing" -->
    <SolidColorBrush x:Key="Accent" Color="#CFA565" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#33B08D57" />
    <SolidColorBrush x:Key="Accent.SoftHover" Color="#4DB08D57" />
    <SolidColorBrush x:Key="Accent.Border" Color="#A6B08D57" />
    <SolidColorBrush x:Key="Accent.Text" Color="#F0E6D2" />

    <!-- Blue means live: a number being measured now, words still being heard, a model still
         loading. Brass is what you can act on; blue is what is happening. Used sparingly, so
         that it keeps meaning that. -->
    <SolidColorBrush x:Key="Live" Color="#64B9D3" />
    <SolidColorBrush x:Key="Ok" Color="#2FBFA9" />
    <SolidColorBrush x:Key="Caution" Color="#D9A44A" />
    <SolidColorBrush x:Key="Danger" Color="#E5636B" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#33E5636B" />

    <!-- Notices -->
    <SolidColorBrush x:Key="Notice.Warn.Bg" Color="#241E10" />
    <SolidColorBrush x:Key="Notice.Warn.Line" Color="#5A4A22" />
    <SolidColorBrush x:Key="Notice.Error.Bg" Color="#2A1416" />
    <SolidColorBrush x:Key="Notice.Error.Line" Color="#6B2B30" />

    <SolidColorBrush x:Key="Selection" Color="#59B08D57" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#2C3440" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#465163" />
    <SolidColorBrush x:Key="Close.Hover" Color="#C42B1C" />

    <Color x:Key="Shadow.Color">#000000</Color>

</ResourceDictionary>
