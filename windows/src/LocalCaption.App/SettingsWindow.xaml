<Window x:Class="LocalCaption.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Note">
            <Setter Property="Foreground" Value="#6B6B70" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Padding="14,6" MinWidth="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Padding="14,6" MinWidth="88" IsDefault="True" Click="OnSave" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource Heading}" Text="Audio source" Margin="0,0,0,6" />
                <RadioButton x:Name="ModeProcess" GroupName="Mode" Content="Capture one application" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Recommended. Captures what the meeting app plays, whatever output device it ends up on — so it survives a Jump Desktop session connecting or disconnecting mid-call." />
                <ComboBox x:Name="ProcessPicker" Margin="20,6,0,0" DisplayMemberPath="Label" />

                <RadioButton x:Name="ModeEndpoint" GroupName="Mode" Content="Capture an output device"
                             Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Captures everything played to one device, including notifications and music." />
                <ComboBox x:Name="EndpointPicker" Margin="20,6,0,0" DisplayMemberPath="Label" />

                <TextBlock Style="{StaticResource Heading}" Text="Speech recognition" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Live captions model" />
                        <ComboBox x:Name="InterimModel" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Final transcript model" />
                        <ComboBox x:Name="FinalModel" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Compute backend" Margin="0,10,0,0" />
                <ComboBox x:Name="Backend" />
                <TextBlock x:Name="BackendNote" Style="{StaticResource Note}" />

                <TextBlock Style="{StaticResource Heading}" Text="Captions" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Font size" VerticalAlignment="Center" Width="90" />
                    <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="32" Width="220"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat={}{0:0}}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Note}"
                           Text="Worth raising for remote use — video compression is unkind to small text." />
                <CheckBox x:Name="AutoScroll" Content="Follow the latest caption" Margin="0,8,0,0" />
                <CheckBox x:Name="ShowTimestamps" Content="Timestamps in saved transcripts" Margin="0,6,0,0" />

                <TextBlock Style="{StaticResource Heading}" Text="Clipboard" />
                <CheckBox x:Name="AutoUpdate" Content="Copy the latest captions automatically" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Off by default. It writes every few seconds, so over a synced clipboard it will overwrite whatever you copied on your own machine — turn Jump Desktop's clipboard sync off while recording, then this is safe. The transcript file, not the clipboard, is the durable copy." />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Sentences to copy" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="RecentSentences" Width="60" Padding="6,4" />
                </StackPanel>

                <TextBlock Style="{StaticResource Heading}" Text="Detection (applies at next Start)" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sensitivity" VerticalAlignment="Center" Width="120" />
                    <Slider x:Name="VadSensitivity" Minimum="0" Maximum="3" Width="200"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="End of speech (ms)" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="EndpointSilence" Width="80" Padding="6,4" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Longest phrase (s)" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="MaxUtterance" Width="80" Padding="6,4" />
                </StackPanel>

                <TextBlock Style="{StaticResource Heading}" Text="Transcripts" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TranscriptFolder" Width="380" Padding="6,4" />
                    <Button Content="Open" Padding="14,6" Margin="8,0,0,0" Click="OnOpenFolder" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
