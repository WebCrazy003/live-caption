{
  "name": "slug",
  "description": "LibrarySlug.make: diacritic, case and width folding (Foundation's, not Unicode compatibility folding: superscripts and ordinals are dropped, but full case folding expands ß and the Latin ligatures), then [a-z0-9] with every other run collapsed to one dash, no leading or trailing dash, 'item' when nothing is left. A slug already taken gets -2, -3… (the first free one).",
  "kind": "slug",
  "cases": [
    { "title": "CV 2026 — Final!", "expect": "cv-2026-final" },
    { "title": "Résumé", "expect": "resume" },
    { "title": "Re\u0301sume\u0301", "expect": "resume" },
    { "title": "Ünïcödé Ñotes Ça Øre", "expect": "unicode-notes-ca-re" },
    { "title": "UPPER Case MiXeD", "expect": "upper-case-mixed" },
    { "title": "ＣＶ\u3000２０２６", "expect": "cv-2026" },
    { "title": "ｊｏｂ－ｓｐｅｃ", "expect": "job-spec" },
    { "title": "Straße ẞ", "expect": "strasse-ss" },
    { "title": "ﬁnal ﬂow", "expect": "final-flow" },
    { "title": "İstanbul", "expect": "istanbul" },
    { "title": "x² ª 1º ½", "expect": "x-1" },
    { "title": "Æsir ﬀ", "expect": "sir-ff" },
    { "title": "a -- b __ c!!?", "expect": "a-b-c" },
    { "title": "--leading and trailing--", "expect": "leading-and-trailing" },
    { "title": "  spaced\tout\n", "expect": "spaced-out" },
    { "title": "C++ / C# notes", "expect": "c-c-notes" },
    { "title": "a\u200cb a\u20ddb a\ud83c\udffdb", "expect": "ab-ab-ab" },
    { "title": "a\u200db", "expect": "a-b" },
    { "title": "日本語のメモ", "expect": "item" },
    { "title": "😀 notes 😀", "expect": "notes" },
    { "title": "", "expect": "item" },
    { "title": "***", "expect": "item" },
    { "title": "cv", "taken": ["cv", "cv-2"], "expect": "cv-3" },
    { "title": "cv", "taken": ["cv-2"], "expect": "cv" },
    { "title": "CV", "taken": ["cv"], "expect": "cv-2" },
    { "title": "cv", "taken": ["cv", "cv-2", "cv-3", "cv-5"], "expect": "cv-4" },
    { "title": "", "taken": ["item"], "expect": "item-2" },
    { "title": "Notes 2", "taken": ["notes-2"], "expect": "notes-2-2" }
  ]
}
