{
  "name": "session-name",
  "description": "InterviewRecord.sessionName: <interviewee>-<company>-<step>-<yyyy-MM-dd>, each part trimmed of whitespace and newlines, empty parts skipped, inner spaces kept; null when neither the interviewee nor the company is known. local_time is a wall-clock time in the test machine's own time zone, so the day is the same everywhere.",
  "kind": "session_name",
  "cases": [
