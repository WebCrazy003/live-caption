{
  "name": "endpoint-fires-only-after-speech",
  "description": "600 ms of silence closes an utterance \u2014 but only one that started. 8000 quiet samples (500 ms) are not enough; the next 1600 cross the threshold and finalize. Transitions drain exactly once, and the long silence that follows produces nothing.",
  "tuning": {
    "endpoint_ms": 600,
    "interval_ms": 500,
    "max_utterance_s": 20,
    "threshold": 0.015
  },
  "steps": [
    {
      "op": "append",
      "now": 1.0,
      "runs": [
        {
          "amplitude": 0.1,
          "count": 16000
        }
      ],
      "expect_final_count": 0
    },
    {
      "op": "append",
      "now": 1.5,
      "runs": [
        {
          "amplitude": 0.0,
          "count": 8000
        }
      ],
      "expect_requests": []
    },
    {
      "op": "append",
      "now": 1.6,
      "runs": [
        {
          "amplitude": 0.0,
          "count": 1600
        }
      ],
      "expect_final_count": 1
    },
    {
      "op": "drain_transitions",
      "expect_transitions": [
        {
          "utterance": 0,
          "sample": 0,
          "started": true
        },
        {
          "utterance": 0,
          "sample": 25600,
          "started": false
        }
      ]
    },
    {
      "op": "drain_transitions",
      "expect_transitions": []
    },
    {
      "op": "append",
      "now": 11.6,
      "runs": [
        {
          "amplitude": 0.0,
          "count": 160000
        }
      ],
      "expect_requests": []
    }
  ]
}
