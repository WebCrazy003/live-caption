<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>LocalCaption</string>
    <key>CFBundleDisplayName</key>
    <string>Local Caption</string>
    <key>CFBundleIdentifier</key>
    <string>com.livecaption.app</string>
    <key>CFBundleExecutable</key>
    <string>LocalCaption</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- System audio is captured via ScreenCaptureKit (decision B3); macOS prompts for the
         Screen Recording permission at runtime. The microphone is used only when
         Settings ▸ Record audio is set to "My microphone". -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Local Caption records your microphone to an audio file when you turn on “Record audio: My microphone” in Settings. Captions still come from the call audio.</string>
    <!-- Accent mode (SPEC-18): find and talk to the RTX agent on the local network over plain
         HTTP. macOS asks for the Local Network permission the first time. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Accent mode sends call audio to your RTX desktop on this network, which runs the speech models.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_localcaption._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
