<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>LocalCaption</string>
    <key>CFBundleDisplayName</key>
    <string>Local Caption</string>
    <key>CFBundleIdentifier</key>
    <string>com.livecaption.app</string>
    <key>CFBundleExecutable</key>
    <string>LocalCaption</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- System audio is captured via ScreenCaptureKit (decision B3); macOS prompts for the
         Screen Recording permission at runtime. No NSMicrophoneUsageDescription is needed. -->
    <!-- SPEC-10 live summary talks to a local on-device mlx_lm.server over http://127.0.0.1.
         Allow localhost HTTP only; nothing leaves the machine. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
